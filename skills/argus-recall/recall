#!/bin/sh
# Argus 과거 대화 검색(argus-recall 스킬). ~/.claude/skills·Codex 스킬 폴더에 링크돼 있어도 저장소의 csl/cli.py 를 찾는다
here="$(cd "$(dirname "$(realpath "$0")")" && pwd)"
# Codex 스킬 폴더로 불렸으면 지금 세션 ID 를 Codex 것(CODEX_THREAD_ID)으로 읽게 한다
case "$0" in
  "${CODEX_HOME:-$HOME/.codex}"/skills/*) export ARGUS_AGENT=codex ;;
esac
# 검색은 기본으로 지금 세션의 프로젝트만(cli.py 가 ARGUS_SCOPE 를 본다)
ARGUS_SCOPE=project exec /usr/bin/python3 "$here/../../csl/cli.py" "$@"
